# Backend
NEXT_PUBLIC_BACKEND_URL=

# Auth (NextAuth secret — openssl rand -base64 32)
AUTH_SECRET=

# Naver Maps
NEXT_PUBLIC_NAVER_ID=

# Kakao OAuth
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URL=

# Toss Payments
NEXT_PUBLIC_TOSS_CLIENT_KEY=

