{
  "name": "carry-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "pnpm": ">=9.5.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\"",
    "validate": "turbo run lint typecheck test",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/*/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "apps/*/src/**/*.css": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "turbo": "^2.5.4"
  }
}
